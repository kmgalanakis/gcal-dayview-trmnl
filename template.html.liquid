        var left = gutter + 6 + ev.col * width;
        var time = ev.start + (ev.end !== ev.start ? ' – ' + ev.end : '');
        var tag = ev.state === 'now' ? 'NOW' : ev.state === 'next' ? 'NEXT' : '';
