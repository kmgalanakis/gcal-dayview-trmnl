            (ev.location && height >= 58 ? '<br>' + esc(ev.location) : '') + '</span>'
          : '<span class="gtl__title gtl__title--inline">' + esc(ev.title) + '<span class="gtl__meta"> · ' + esc(ev.start) + '</span></span>';
        if (tag && roomy && !narrow) body += '<span class="gtl__tag">' + tag + '</span>';
        html += '<div class="gtl__event gtl__event--' + ev.state + ' gtl--' + styleOf(ev.cal) + (roomy ? '' : ' gtl__event--compact') + (narrow ? ' gtl__event--narrow' : '') +
          '" style="top:' + t0 + 'px;height:' + height + 'px;left:' + Math.round(left) + 'px;width:' + Math.round(width - 4) + 'px">' + body + '</div>';
