(function () {
  var root = document.getElementById('gcal-root');
  var esc = function (s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  };
  var message = function (title, text) {
    root.innerHTML = '<div class="gcal__empty"><div class="flex flex--col gap--small"><span class="title">' + esc(title) +
      '</span>' + (text ? '<span class="description">' + esc(text) + '</span>' : '') + '</div></div>';
  };

  try {
    var feedCount = {{ feeds.size }};
    if (!feedCount) return message('Waiting for calendar data…', 'Check the extension\'s Exchanges → Errors tab.');

    var dataEl = document.getElementById('gcal-data');
    var events = JSON.parse(dataEl.getAttribute('data-events') || '[]');
    var declined = GCal.declinedKeys(JSON.parse(dataEl.getAttribute('data-declined') || '[]'), dataEl.getAttribute('data-me'));
    var cal = GCal.agenda(events, {
      declined: declined,
      timezone: {{ extension.values.timezone | default: "Europe/Athens" | jsonify }},
      locale: {{ extension.values.locale | default: "en-GB" | jsonify }},
      hour12: {{ extension.values.clock | default: "24h" | jsonify }} === '12h',
      hideFree: {{ extension.values.hide_free | default: "no" | jsonify }} === 'yes',
      limit: {{ extension.values.max_events | default: 7 | plus: 0 }}
    });

    document.getElementById('gcal-updated').textContent = 'Updated ' + cal.updated;

    if ({{ extension.values.layout | default: "agenda" | jsonify }} === 'timeline') {
      document.getElementById('gcal-updated').textContent = 'Updated ' + cal.updated;

      var split = function (s) { return String(s || '').split(',').map(function (x) { return x.trim(); }).filter(String); };
      var calNames = split({{ extension.values.calendar_names | default: "" | jsonify }});
      var calStyles = split({{ extension.values.calendar_styles | default: "solid, outline, striped" | jsonify }});
      var styleOf = function (i) {
        var st = (calStyles[i] || ['solid', 'outline', 'striped'][i] || 'outline').toLowerCase();
        return ['solid', 'outline', 'striped'].indexOf(st) >= 0 ? st : 'outline';
      };

      var dayStartH = {{ extension.values.day_start | default: 9 | plus: 0 }};
      var dayEndH = {{ extension.values.day_end | default: 18 | plus: 0 }};
      cal.timeline.forEach(function (ev) {
        dayStartH = Math.min(dayStartH, Math.floor(ev.startMin / 60));
        dayEndH = Math.max(dayEndH, Math.ceil(ev.endMin / 60));
      });
      dayStartH = Math.max(0, dayStartH);
      dayEndH = Math.min(24, Math.max(dayEndH, dayStartH + 1));

      // ---- header: big date, legend, now/next pill ----
      var up = cal.current
        ? { kicker: 'Now · ' + cal.current.relative, ev: cal.current }
        : cal.next ? { kicker: 'Next · ' + cal.next.relative, ev: cal.next } : null;
      var usedCals = {};
      cal.timeline.concat(cal.all_day).forEach(function (e) { usedCals[e.cal] = true; });
      var legendIds = Object.keys(usedCals).map(Number).sort();
      var legend = (calNames.length > 1 || legendIds.length > 1) ? '<div class="gtl__legend">' +
        legendIds.map(function (i) {
          return '<span class="gtl__legend-item"><span class="gtl__swatch gtl--' + styleOf(i) + '"></span>' +
            esc(calNames[i] || ('Calendar ' + (i + 1))) + '</span>';
        }).join('') + '</div>' : '';

      var top = '<div class="gtl__top">' +
        '<span class="gtl__day">' + esc(cal.day) + '</span>' +
        '<div class="gtl__when"><span class="gtl__weekday">' + esc(cal.weekday) + '</span>' +
        '<span class="gtl__month">' + esc(cal.month) + ' ' + esc(cal.year) + '</span>' +
        '<span class="gtl__month">' + (cal.total ? cal.remaining + ' of ' + cal.total + ' meetings left' : 'No meetings') + '</span></div>' +
        '<span class="gtl__spacer"></span>' + legend +
        (up ? '<div class="gtl__up"><span class="gtl__up-kicker">' + esc(up.kicker) + '</span>' +
          '<span class="gtl__up-title">' + esc(up.ev.title) + '</span>' +
          '<span class="gtl__up-time">' + esc(up.ev.start) + ' – ' + esc(up.ev.end) + '</span></div>'
          : '<div class="gtl__up"><span class="gtl__up-kicker">Up next</span><span class="gtl__up-title">Nothing else today</span></div>') +
        '</div>';

      var allDay = !cal.all_day.length ? '' : '<div class="gtl__allday">' + cal.all_day.slice(0, 5).map(function (a) {
        return '<span class="gtl__chip gtl--' + styleOf(a.cal) + '">' + esc(a.title) + '</span>';
