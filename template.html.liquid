    }

    var card = function (kind, ev, extra) {
      return '<div class="gcal__card' + (kind === 'NOW' ? ' gcal__card--now' : '') + '">' +
        '<div class="gcal__row"><span class="label label--small">' + kind + '</span>' +
        '<span class="label label--small' + (kind === 'NOW' ? '' : ' label--underline') + '">' + esc(ev.relative) + '</span></div>' +
        '<span class="title title--small gcal__one-line">' + esc(ev.title) + '</span>' +
